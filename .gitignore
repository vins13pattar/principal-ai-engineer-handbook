# Dependencies
node_modules/
.pnpm-store/

# Astro / Starlight build output
dist/
.astro/

# Wrangler local state — caches the Cloudflare account ID and build metadata.
# Never belongs in the repo, least of all a public one.
.wrangler/

# Pagefind search index (generated at build time)
**/public/pagefind/

# Testing
coverage/
playwright-report/
test-results/
blob-report/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build info
*.tsbuildinfo

# Agent scratch. Both hold working state for an in-progress task -- worktree
# checkouts and per-plan ledgers, briefs, and review packages. Neither is
# ignored by default, and an unignored worktree directory commits an entire
# second checkout into the repo.
.claude/worktrees/
.superpowers/

# Python (labs)
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Lab lockfiles. None of the twelve labs has ever tracked one, and a lockfile
# appearing in exactly one of them is the kind of inconsistency that reads as a
# decision when it was an accident. Each lab declares its own bounds in
# pyproject.toml and is installed fresh; a reader running one should resolve
# against what is current, not against whatever resolved on the author's laptop.
labs/*/uv.lock

# Operator configuration and generated episode runs.
podcast.config.json
# Podcast run directories. `--out` names one, so match any of them rather
# than only the default: a run written to `.podcast-local/` is the same
# throwaway artifact and got committed once by a `git add -A`.
.podcast*/

# Working podcast configs. Only the example is tracked; a local config carries
# endpoints, model ids and prices that are the operator's, not the repo's.
podcast.*.json
!podcast.config.example.json

# Generated podcast episodes. These live in the handbook-podcast R2 bucket;
# see docs/PODCAST.md. Committing them puts a megabyte per episode into every
# clone forever, for bytes the CDN already serves.
apps/handbook/public/podcast/
