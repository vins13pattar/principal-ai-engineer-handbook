{
  "name": "@handbook/video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Remotion project that renders the Learn module videos from the handbook's own content.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "layout": "node --experimental-strip-types scripts/layout-diagrams.ts",
    "still": "remotion still src/index.ts",
    "render": "remotion render src/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "narrate": "node --experimental-strip-types scripts/narrate.ts",
    "transcribe": "node --experimental-strip-types scripts/transcribe.ts",
    "captions": "node --experimental-strip-types scripts/captions.ts",
    "youtube": "node --experimental-strip-types scripts/youtube.ts",
    "sync": "node --experimental-strip-types scripts/sync-videos.ts",
    "render:module": "node --experimental-strip-types scripts/render-module.ts",
    "status": "node --experimental-strip-types scripts/status.ts",
    "sheet": "node --experimental-strip-types scripts/sheet.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/media-utils": "4.0.537",
    "@remotion/paths": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "zod": "4.5.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "elkjs": "0.12.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "@handbook/podcast-engine": "workspace:*",
    "@handbook/podcast-providers": "workspace:*",
    "@remotion/install-whisper-cpp": "4.0.537",
    "@remotion/bundler": "4.0.537",
    "@remotion/renderer": "4.0.537"
  }
}
