---
import Callout from "./Callout.astro";

/** Wraps an ordinary Markdown list and restyles it as a printable checklist. */
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<Callout variant="neutral" glyph="☑" label="Checklist" title={title}>
  <div class="handbook-checklist-body">
    <slot />
  </div>
</Callout>

<style>
  .handbook-checklist-body :global(ul) {
    list-style: none;
    padding-left: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .handbook-checklist-body :global(li) {
    padding-left: 1.75rem;
    position: relative;
  }
  .handbook-checklist-body :global(li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 1.05em;
    height: 1.05em;
    border: 1.5px solid var(--sl-color-gray-3, #64748b);
    border-radius: 0.25em;
  }

  @media print {
    .handbook-checklist-body :global(li::before) {
      border-color: black;
    }
  }
</style>
