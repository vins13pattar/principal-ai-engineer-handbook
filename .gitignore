# Dependencies
node_modules/
.pnpm-store/

# Astro / Starlight build output
dist/
.astro/

# Wrangler local state — caches the Cloudflare account ID and build metadata.
# Never belongs in the repo, least of all a public one.
.wrangler/

# Pagefind search index (generated at build time)
**/public/pagefind/

# Testing
coverage/
playwright-report/
test-results/
blob-report/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build info
*.tsbuildinfo

# Agent scratch. Both hold working state for an in-progress task -- worktree
# checkouts and per-plan ledgers, briefs, and review packages. Neither is
# ignored by default, and an unignored worktree directory commits an entire
# second checkout into the repo.
.claude/worktrees/
.superpowers/

# Python (labs)
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Operator configuration and generated episode runs.
podcast.config.json
.podcast/
