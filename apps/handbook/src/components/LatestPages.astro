---
import { getCollection } from "astro:content";
import { sortByLastUpdatedDesc } from "../lib/sort";

interface Props {
  title: string;
  /** Docs collection id prefix to filter on, e.g. "build/labs/". */
  prefix: string;
  limit?: number;
}

const { title, prefix, limit = 3 } = Astro.props;
const entries = await getCollection("docs", (entry) => entry.id.startsWith(prefix));
const latest = sortByLastUpdatedDesc(entries).slice(0, limit);
const base = import.meta.env.BASE_URL;
---

{
  latest.length > 0 && (
    <div class="handbook-latest">
      <h3>{title}</h3>
      <ul>
        {latest.map((entry) => (
          <li>
            <a href={`${base}${entry.id}/`}>{entry.data.title}</a>
            {entry.data.lastUpdated && (
              <span class="handbook-latest__date">
                {entry.data.lastUpdated.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .handbook-latest h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .handbook-latest ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .handbook-latest li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9rem;
  }
  .handbook-latest__date {
    color: var(--sl-color-gray-3, #64748b);
    white-space: nowrap;
  }
</style>
